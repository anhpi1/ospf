	"Simple module": {
		"prefix": ["simple"],
		"body": [
			"simple ${1:ModuleName}",
			"{",
			"\tparameters:",
			"\t\t${2:@display(\"i=block/process\");}",
			"\tgates:",
			"\t\t${3:}",
			"}"
		],
		"description": "Simple module definition"
	},

	"Simple module with inheritance": {
		"prefix": ["simple-extends"],
		"body": [
			"simple ${1:DerivedModule} extends ${2:BaseModule}",
			"{",
			"\tparameters:",
			"\t\t${3:@display(\"i=block/process\");}",
			"\tgates:",
			"\t\t${4:}",
			"}"
		],
		"description": "Simple module that extends another"
	},

